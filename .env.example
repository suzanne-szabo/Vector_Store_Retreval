# Copy to .env and replace both placeholder keys with your assigned key.
# The course services are reachable only on the course network or over Tailscale.
#
# Over Tailscale, the host names may not resolve. If a service cannot be reached, use the
# gateway's Tailscale address instead (verified 2026-10-26: curl returned 401, i.e. reachable):
#   http://100.64.0.1:4000/v1

EMBEDDING_BASE_URL=http://golem.cs.utahtech.edu:4000/v1
EMBEDDING_MODEL=Qwen3-Embedding-8B
EMBEDDING_API_KEY=student-should-use-their-own

LLM_BASE_URL=http://golem:4000/v1
# The assignment's service file names Qwen3.8-27B, but course API keys get HTTP 403 for it
# (2026-10-27); Qwen3.8-Flash-Next is the recorded chat model (architecture D22).
LLM_MODEL=Qwen3.8-Flash-Next
LLM_API_KEY=student-should-use-their-own

# Folder holding the corpus PDFs (kept outside this repository).
DOCUMENTS_DIR=../U0-HW-09-materials/documents/personal_documents
